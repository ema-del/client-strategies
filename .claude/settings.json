      "Agent",
      "Skill",
      "ToolSearch",
      "mcp__Google_Drive",
      "mcp__Google_Sheets",
      "mcp__Google_Docs",
      "mcp__Google_Calendar",
      "mcp__Gmail",
      "mcp__Meta_ads",
      "mcp__Airtable",
      "mcp__ClickUp",
      "mcp__Canva",
      "mcp__Slack",
      "mcp__Whimsical",
      "mcp__Atlassian_Rovo",
      "mcp__Claude_Docs",
      "mcp__claude-code-remote",
      "mcp__github",
